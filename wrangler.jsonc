{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcs-portfolio",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "tylercsamuelson.com", "custom_domain": true },
    { "pattern": "www.tylercsamuelson.com", "custom_domain": true }
  ],
  // Assets-only Worker: dist/ is produced by `npm run build`.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
